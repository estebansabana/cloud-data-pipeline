# Plantilla de configuracion. Copiar como .env y completar los valores.
#   cp .env.example .env
# El archivo .env NO se versiona (ver .gitignore).

# --- Foursquare Places API ---
# Service API Key generada en https://foursquare.com/developers
FOURSQUARE_API_KEY=""

# --- AWS Academy Learner Lab (credenciales temporales, expiran cada 4 h) ---
# Obtener desde: Vocareum -> AWS Details -> Show
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_SESSION_TOKEN=""
AWS_DEFAULT_REGION="us-east-1"

# --- Data Lake ---
# Nombre del bucket S3 propio. Debe ser unico a nivel global.
S3_BUCKET_NAME=""
